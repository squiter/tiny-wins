{
  "expo": {
    "name": "Tiny Wins",
    "slug": "tiny-wins",
    "scheme": "tinywins",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Opener-Policy": "same-origin",
            "Cross-Origin-Embedder-Policy": "require-corp"
          }
        }
      ],
      "expo-sqlite",
      "expo-font",
      "expo-status-bar",
      "./scripts/with-android-navigation-theme.cjs",
      ["expo-navigation-bar", { "enforceContrast": false, "hidden": false }],
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/mark-light.png",
          "imageWidth": 96,
          "resizeMode": "contain",
          "backgroundColor": "#FBF8F1",
          "dark": {
            "image": "./assets/branding/mark-dark.png",
            "backgroundColor": "#141B17"
          }
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "app.tinywins.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "app.tinywins.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/adaptive-foreground.png",
        "backgroundColor": "#FBF8F1",
        "monochromeImage": "./assets/branding/adaptive-monochrome.png"
      }
    },
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "icon": "./assets/branding/icon.png"
  }
}
